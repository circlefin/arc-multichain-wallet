# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Circle
CIRCLE_API_KEY=your-circle-api-key
CIRCLE_ENTITY_SECRET=your-circle-entity-secret

# Arc testnet RPC provider (required; previously hardcoded in source)
# Get your own key from your RPC provider and rotate the old one.
ARC_TESTNET_RPC_KEY=

# Administrator email for gated operational endpoints
ADMIN_EMAIL=
