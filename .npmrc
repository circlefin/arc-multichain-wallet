# wagmi's Coinbase connector (@wagmi/connectors -> @base-org/account -> @coinbase/cdp-sdk)
# pulls in an unconditional Solana dependency chain that has a peerOptional version
# conflict with @circle-fin/developer-controlled-wallets' own optional Solana peer.
# This app is EVM-only and never touches Solana; legacy-peer-deps skips the strict
# peer check so `npm install` succeeds. Safe to drop if either package fixes its
# peer ranges upstream.
legacy-peer-deps=true
